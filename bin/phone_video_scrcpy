#!/bin/bash
# 通用手机视频串流（屏幕镜像 / 相机）
# 用法: phone_video_scrcpy <序列号|IP:端口> <screen|camera|camera-back> [显示名]
# 特性: 单实例(按设备+模式)、断线自动重连、显示窗口、不转发音频
set -u

TARGET="${1:-}"
MODE="${2:-screen}"
NAME="${3:-$TARGET}"
if [[ -z $TARGET ]]; then
    echo "用法: phone_video_scrcpy <序列号|IP:端口> <screen|camera|camera-back> [显示名]"
    exit 1
fi

case "$MODE" in
    screen) MODE_KEY="screen" ;;
    camera|camera-front|camera_front) MODE_KEY="camera" ;;
    camera-back|camera_back) MODE_KEY="camera_back" ;;
    *) echo "未知模式: $MODE"; exit 1 ;;
esac

WAIT_TIMEOUT=120
INTERVAL=2
CACHE_DIR="${PHONE_STREAM_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/phone-stream}"
mkdir -p "$CACHE_DIR"

if [[ $TARGET == *:* ]]; then
    KIND=addr
    ID=$(printf '%s' "$TARGET" | tr '.:' '__')"_$MODE_KEY"
else
    KIND=serial
    ID=$(printf '%s' "$TARGET" | tr -c 'A-Za-z0-9_' '_')"_$MODE_KEY"
fi
SAFE_NAME=$(printf '%s' "$NAME" | tr -d '"\\')
CACHE_FILE="$CACHE_DIR/stream_$ID.addr"
PID_FILE="$CACHE_DIR/stream_$ID.pid"

exec 9>"$CACHE_DIR/stream_$ID.lock"
flock -n 9 || { echo "已在串流: $NAME $MODE"; exit 0; }

echo $$ > "$PID_FILE"
cleanup() { kill 0 2>/dev/null; rm -f "$PID_FILE"; exit 0; }
trap cleanup TERM INT
rm -f "$PID_FILE" 2>/dev/null; echo $$ > "$PID_FILE"

LOG() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
dev_state() { adb devices | awk -v a="$1" '$1==a{print $2}'; }
save_addr() { printf '%s' "$1" > "$CACHE_FILE"; }
load_addr() { [[ -r $CACHE_FILE ]] && head -1 "$CACHE_FILE" || true; }

discover() {
    local line addr first=""
    while IFS= read -r line; do
        addr=$(awk -F';' '{print $8":"$9}' <<<"$line")
        [[ -z $first ]] && first="$addr"
        if timeout 1 bash -c "exec 3<>/dev/tcp/${addr%:*}/${addr#*:}" 2>/dev/null; then
            echo "$addr"
            return 0
        fi
    done < <(avahi-browse -rtp _adb-tls-connect._tcp 2>/dev/null | grep '=;.*;IPv4;' |
             grep -E ";adb-${TARGET}-|\"serial=${TARGET}\"" | sort -u)
    [[ -n $first ]] && echo "$first"
}

resolve_addr() {
    if [[ $KIND == addr ]]; then
        echo "$TARGET"
        return
    fi
    local a
    a=$(load_addr)
    if [[ -n $a ]] && [[ $(dev_state "$a") == device ]]; then
        echo "$a"
        return
    fi
    a=$(discover)
    if [[ -n $a ]]; then
        echo "$a"
        return
    fi
    load_addr
}

ADDR=$(resolve_addr)
if [[ -z $ADDR ]]; then
    LOG "未找到设备: $TARGET"
    exit 1
fi

case "$MODE_KEY" in
    screen) WINTITLE="$SAFE_NAME 屏幕"; VID_ARGS=() ;;
    camera) WINTITLE="$SAFE_NAME 相机"
            VID_ARGS=(--video-source=camera --camera-facing=front --capture-orientation=0
                      --camera-size=1280x720 --camera-fps=30) ;;
    camera_back) WINTITLE="$SAFE_NAME 后置相机"
            VID_ARGS=(--video-source=camera --camera-facing=back --capture-orientation=0
                      --camera-size=1280x720 --camera-fps=30) ;;
esac

LOG "视频串流启动: $WINTITLE ($ADDR)"
while true; do
    adb connect "$ADDR" >/dev/null 2>&1
    waited=0
    while [[ $(dev_state "$ADDR") != device ]]; do
        sleep "$INTERVAL"
        waited=$((waited + INTERVAL))
        if [[ $KIND == serial ]]; then
            a=$(discover)
            [[ -n $a ]] && ADDR="$a"
        fi
        adb connect "$ADDR" >/dev/null 2>&1
        [[ $(dev_state "$ADDR") == device ]] && break
        if ((waited >= WAIT_TIMEOUT)); then
            LOG "连接超时: $ADDR"
            exit 1
        fi
    done
    save_addr "$ADDR"

    scrcpy --window-title="$WINTITLE" -s "$ADDR" --no-audio "${VID_ARGS[@]}"
    rc=$?
    if ((rc == 0 || rc == 130)); then
        LOG "已退出"
        exit 0
    fi
    LOG "连接中断(rc=${rc})，尝试重连..."
    rm -f "$CACHE_FILE" 2>/dev/null
    sleep 3
    ADDR=$(resolve_addr)
    if [[ -z $ADDR ]]; then
        LOG "设备丢失: $TARGET"
        exit 1
    fi
done
