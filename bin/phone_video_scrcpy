#!/bin/bash
# Generic phone video streaming (screen mirror / camera).
# Usage: phone_video_scrcpy <serial|IP:port|usb:serial> <screen|camera|camera-back> [name]
#   serial    : auto-discover the device address via mDNS
#   IP:port   : use directly (e.g. manually added devices)
#   usb:serial: use a USB-connected device directly (no discovery/connect)
# Features: one instance per device+mode, auto-reconnect, shows a window, no audio.
set -u

TARGET="${1:-}"
MODE="${2:-screen}"
NAME="${3:-$TARGET}"
if [[ -z $TARGET ]]; then
    echo "Usage: phone_video_scrcpy <serial|IP:port> <screen|camera|camera-back> [name]"
    exit 1
fi

case "$MODE" in
    screen) MODE_KEY="screen" ;;
    camera|camera-front|camera_front) MODE_KEY="camera" ;;
    camera-back|camera_back) MODE_KEY="camera_back" ;;
    *) echo "unknown mode: $MODE"; exit 1 ;;
esac

WAIT_TIMEOUT=120
INTERVAL=2
CACHE_DIR="${PHONE_STREAM_HOME:-${XDG_CONFIG_HOME:-$HOME/.config}/phone-stream}"
mkdir -p "$CACHE_DIR"

if [[ $TARGET == usb:* ]]; then
    KIND=usb
    TARGET="${TARGET#usb:}"
    ID=$(printf '%s' "$TARGET" | tr -c 'A-Za-z0-9_' '_')"_$MODE_KEY"
elif [[ $TARGET == *:* ]]; then
    KIND=addr
    ID=$(printf '%s' "$TARGET" | tr '.:' '__')"_$MODE_KEY"
else
    KIND=serial
    ID=$(printf '%s' "$TARGET" | tr -c 'A-Za-z0-9_' '_')"_$MODE_KEY"
fi
SAFE_NAME=$(printf '%s' "$NAME" | tr -d '"\\')
CACHE_FILE="$CACHE_DIR/stream_$ID.addr"
PID_FILE="$CACHE_DIR/stream_$ID.pid"

exec 9>"$CACHE_DIR/stream_$ID.lock"
flock -n 9 || { echo "already streaming: $NAME $MODE"; exit 0; }

echo $$ > "$PID_FILE"
cleanup() { kill 0 2>/dev/null; rm -f "$PID_FILE"; exit 0; }
trap cleanup TERM INT
rm -f "$PID_FILE" 2>/dev/null; echo $$ > "$PID_FILE"

LOG() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*"; }
dev_state() { adb devices | awk -v a="$1" '$1==a{print $2}'; }
save_addr() { printf '%s' "$1" > "$CACHE_FILE"; }
load_addr() { [[ -r $CACHE_FILE ]] && head -1 "$CACHE_FILE" || true; }

discover() {
    # Collect candidates by serial, TCP-probe each and return the live one.
    local line addr first=""
    while IFS= read -r line; do
        addr=$(awk -F';' '{print $8":"$9}' <<<"$line")
        [[ -z $first ]] && first="$addr"
        if timeout 1 bash -c "exec 3<>/dev/tcp/${addr%:*}/${addr#*:}" 2>/dev/null; then
            echo "$addr"
            return 0
        fi
    done < <(avahi-browse -rtp _adb-tls-connect._tcp 2>/dev/null | grep '=;.*;IPv4;' |
             grep -E ";adb-${TARGET}-|\"serial=${TARGET}\"" | sort -u)
    [[ -n $first ]] && echo "$first"
}

resolve_addr() {
    if [[ $KIND == addr || $KIND == usb ]]; then
        echo "$TARGET"
        return
    fi
    local a
    a=$(load_addr)
    if [[ -n $a ]] && [[ $(dev_state "$a") == device ]]; then
        echo "$a"
        return
    fi
    a=$(discover)
    if [[ -n $a ]]; then
        echo "$a"
        return
    fi
    load_addr
}

ADDR=$(resolve_addr)
if [[ -z $ADDR ]]; then
    LOG "device not found: $TARGET"
    exit 1
fi

case "$MODE_KEY" in
    screen) WINTITLE="$SAFE_NAME screen"; VID_ARGS=() ;;
    camera) WINTITLE="$SAFE_NAME camera"
            VID_ARGS=(--video-source=camera --camera-facing=front --capture-orientation=0
                      --camera-size=1280x720 --camera-fps=30) ;;
    camera_back) WINTITLE="$SAFE_NAME back-camera"
            VID_ARGS=(--video-source=camera --camera-facing=back --capture-orientation=0
                      --camera-size=1280x720 --camera-fps=30) ;;
esac

LOG "video stream start: $WINTITLE ($ADDR)"
while true; do
    [[ $KIND != usb ]] && adb connect "$ADDR" >/dev/null 2>&1
    waited=0
    while [[ $(dev_state "$ADDR") != device ]]; do
        sleep "$INTERVAL"
        waited=$((waited + INTERVAL))
        if [[ $KIND == serial ]]; then
            a=$(discover)
            [[ -n $a ]] && ADDR="$a"
        fi
        [[ $KIND != usb ]] && adb connect "$ADDR" >/dev/null 2>&1
        [[ $(dev_state "$ADDR") == device ]] && break
        if ((waited >= WAIT_TIMEOUT)); then
            LOG "${KIND} device not found: $ADDR"
            exit 1
        fi
    done
    [[ $KIND != usb ]] && save_addr "$ADDR"

    scrcpy --window-title="$WINTITLE" -s "$ADDR" --no-audio "${VID_ARGS[@]}"
    rc=$?
    if ((rc == 0 || rc == 130)); then
        LOG "exited"
        exit 0
    fi
    LOG "connection lost (rc=${rc}), reconnecting..."
    rm -f "$CACHE_FILE" 2>/dev/null
    sleep 3
    ADDR=$(resolve_addr)
    if [[ -z $ADDR ]]; then
        LOG "device lost: $TARGET"
        exit 1
    fi
done
