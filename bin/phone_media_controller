#!/usr/bin/env python3
# Phone Stream - generic card-based media controller.
# One card per device: connect/disconnect/settings + that device's player/title/state + playback controls.
# Devices: mDNS auto-scan + manual add; config persisted to stream_devices.json.
import os
import re
import json
import fcntl
import signal
import socket
import subprocess
import threading
import time
import tkinter as tk
from tkinter import ttk
from tkinter import simpledialog

_HERE = os.path.dirname(os.path.abspath(__file__))
CONF_DIR = os.environ.get("PHONE_STREAM_HOME") or os.path.expanduser("~/.config/phone-stream")
LOCK = os.path.join(CONF_DIR, "phone_media_controller.lock")
CONFIG = os.path.join(CONF_DIR, "stream_devices.json")
STREAM_SCRIPT = os.path.join(_HERE, "phone_audio_scrcpy")
VIDEO_SCRIPT = os.path.join(_HERE, "phone_video_scrcpy")
POLL_MS = 1500
SCAN_MS = 6000

# UI language: English by default, Chinese via PHONE_STREAM_LANG=zh or the in-app button.
SETTINGS = os.path.join(CONF_DIR, "settings.json")


def load_lang():
    # A saved in-app choice wins; otherwise PHONE_STREAM_LANG; otherwise English.
    try:
        with open(SETTINGS) as fh:
            saved = (json.load(fh).get("lang") or "").strip().lower()
            if saved in ("en", "zh"):
                return saved
    except Exception:
        pass
    env = (os.environ.get("PHONE_STREAM_LANG") or "").strip().lower()
    return env if env in ("en", "zh") else "en"


def save_lang(value):
    try:
        os.makedirs(CONF_DIR, exist_ok=True)
        data = {}
        if os.path.exists(SETTINGS):
            try:
                data = json.load(open(SETTINGS)) or {}
            except Exception:
                data = {}
        data["lang"] = value
        with open(SETTINGS, "w") as fh:
            json.dump(data, fh, ensure_ascii=False, indent=2)
    except Exception:
        pass


LANG = load_lang()

