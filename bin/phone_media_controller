    "org.telegram.messenger": "Telegram",
    "com.openai.chatgpt": "ChatGPT",
    "com.tencent.mm": "微信",
}
STATE_NAMES = {
    "PLAYING": "▶ 播放中", "PAUSED": "⏸ 已暂停", "STOPPED": "⏹ 已停止",
    "NONE": "— 无", "BUFFERING": "… 缓冲中", "ERROR": "⚠ 错误",
    "FAST_FORWARDING": "⏩ 快进", "REWINDING": "⏪ 快退",
    "SKIPPING_TO_NEXT": "⏭ 切歌", "SKIPPING_TO_PREVIOUS": "⏮ 切歌",
