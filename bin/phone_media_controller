#!/usr/bin/env python3
# 手机串流 - 通用卡片式媒体控制窗
# 每个设备一张卡片：连接/断开/设置 + 该设备的播放器/曲名/状态 + 播放控制。
# 设备：mDNS 自动扫描 + 手动添加；配置自动保存到 stream_devices.json。
import os
import re
import json
import fcntl
import signal
import socket
import subprocess
import threading
import time
import tkinter as tk
from tkinter import ttk
from tkinter import simpledialog

_HERE = os.path.dirname(os.path.abspath(__file__))
CONF_DIR = os.environ.get("PHONE_STREAM_HOME") or os.path.expanduser("~/.config/phone-stream")
LOCK = os.path.join(CONF_DIR, "phone_media_controller.lock")
CONFIG = os.path.join(CONF_DIR, "stream_devices.json")
STREAM_SCRIPT = os.path.join(_HERE, "phone_audio_scrcpy")
VIDEO_SCRIPT = os.path.join(_HERE, "phone_video_scrcpy")
POLL_MS = 1500
SCAN_MS = 6000

PKG_NAMES = {
    "com.luna.music": "汽水音乐",
