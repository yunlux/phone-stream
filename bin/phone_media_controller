def chip_style(on, color):
    if on:
        return {"bg": color, "fg": CHIP_ON_FG, "activebackground": color,
                "activeforeground": CHIP_ON_FG}
    return {"bg": CHIP_OFF, "fg": CHIP_OFF_FG, "activebackground": CHIP_HI,
            "activeforeground": "#ffffff"}


def apply_style(root):
    # Dark ttk theme so comboboxes / scales / notebook / labelframe match the UI.
    root.option_add("*TCombobox*Listbox.background", CARD)
    root.option_add("*TCombobox*Listbox.foreground", FG)
    root.option_add("*TCombobox*Listbox.selectBackground", "#89b4fa")
    root.option_add("*TCombobox*Listbox.selectForeground", "#11111b")
    st = ttk.Style(root)
    try:
        st.theme_use("clam")
    except Exception:
        return
    st.configure(".", background=BG, foreground=FG, fieldbackground=CARD,
                 bordercolor="#45475a", lightcolor=CARD, darkcolor=CARD)
    st.configure("TNotebook", background=BG, bordercolor="#45475a", tabmargins=(6, 4, 0, 0))
    st.configure("TNotebook.Tab", background="#313244", foreground=SUB, padding=(16, 7),
                 font=(DEF_FONT, 9))
    st.map("TNotebook.Tab", background=[("selected", CARD)], foreground=[("selected", "#89b4fa")])
    st.configure("TCombobox", fieldbackground=CARD, background="#45475a", foreground=FG,
                 arrowcolor=FG, bordercolor="#45475a", selectbackground=CARD, selectforeground=FG)
    st.map("TCombobox", fieldbackground=[("readonly", CARD)], foreground=[("readonly", FG)])
    st.configure("TScale", background=BG, troughcolor="#313244")
    st.configure("TLabelframe", background=BG, bordercolor="#45475a")
    st.configure("TLabelframe.Label", background=BG, foreground="#89b4fa",
                 font=(DEF_FONT, 9, "bold"))


def _running_procs():
    # [(pid, args)] for our own stream scripts ONLY (precise prefix -> no self-match).
    res = []
    try:
        out = subprocess.run(["ps", "-eo", "pid,args"], capture_output=True,
                             text=True, timeout=5).stdout
    except Exception:
        return res
    prefs = ("/bin/bash " + STREAM_SCRIPT, "/bin/bash " + VIDEO_SCRIPT)
    for ln in out.splitlines():
        s = ln.strip()
        parts = s.split(None, 1)
        if len(parts) == 2 and parts[0].isdigit() and parts[1].startswith(prefs):
            res.append((int(parts[0]), parts[1]))
    return res


def _pids(pattern):
    return [pid for pid, args in _running_procs() if pattern in args]


def _kill_tree(pid):
    # Kill a stream's process group (and the pid itself), escalating TERM -> KILL.
    for sig in (signal.SIGTERM, signal.SIGKILL):
        try:
            os.killpg(pid, sig)
        except Exception:
            pass
        try:
            os.kill(pid, sig)
        except Exception:
            pass
        time.sleep(0.4)
        try:
            os.kill(pid, 0)
        except Exception:
            return


def _tcp_ok(ip, port):
    try:
        with socket.create_connection((ip, int(port)), timeout=1.0):
            return True
    except Exception:
        return False


def _sanitize_id(s):
    if ":" in s:
        return re.sub(r"[.:]", "_", s)
    return re.sub(r"[^A-Za-z0-9_]", "_", s)


def stream_target(dev):
    if dev.get("manual"):
        return dev.get("addr", "")
    return dev.get("serial") or dev.get("addr", "")


CONN_KINDS = ("audio", "mic", "screen", "camera")


def usb_ok(dev):
    # True if this device's serial is currently connected over USB (adb id without ':').
    ser = dev.get("serial") or ""
    if not ser or ":" in ser:
        return False
    try:
        out = subprocess.run(["adb", "devices"], capture_output=True, text=True, timeout=4).stdout
    except Exception:
        return False
    for ln in out.splitlines():
        parts = ln.split()
        if len(parts) >= 2 and parts[0] == ser and parts[1] == "device":
            return True
    return False


def conn_choice(dev, kind):
    return (dev.get("conn") or {}).get(kind) or "auto"


def use_usb(dev, kind):
    if dev.get("manual"):
        return False
    ser = dev.get("serial") or ""
    if not ser or ":" in ser:
        return False
    if conn_choice(dev, kind) == "wifi":
        return False
    return usb_ok(dev)  # auto / usb -> use USB when actually present, else fall back to WiFi


def script_target(dev, kind):
    # USB mode -> "usb:<serial>"; otherwise the usual serial / IP:port target.
    if use_usb(dev, kind):
        return "usb:" + dev["serial"]
    return stream_target(dev)


PARAM_DEFAULTS = {
    "audio":  {"buffer": "200", "codec": "flac", "bitrate": "256"},
    "mic":    {"buffer": "200", "codec": "flac", "bitrate": "256"},
    "screen": {"size": "0", "fps": "0", "bitrate": "8", "codec": "h264"},
    "camera": {"size": "1280x720", "fps": "30", "bitrate": "8", "codec": "h264"},
}
PARAM_KEYS = {
    "audio":  ("buffer", "codec", "bitrate"),
    "mic":    ("buffer", "codec", "bitrate"),
    "screen": ("size", "fps", "bitrate", "codec"),
    "camera": ("size", "fps", "bitrate", "codec"),
}


def migrate_params(dev):
    # one-time: build dev["params"] = {kind: {wifi:{...}, usb:{...}}} from old flat keys.
    if isinstance(dev.get("params"), dict):
        return
    p = {}
    for kind in PARAM_KEYS:
        p[kind] = {t: dict(PARAM_DEFAULTS[kind]) for t in ("wifi", "usb")}
    for t, pre in (("wifi", ""), ("usb", "usb_")):
        a = p["audio"][t]
        if (pre + "buffer") in dev:
            a["buffer"] = str(dev[pre + "buffer"])
        if (pre + "codec") in dev:
            a["codec"] = str(dev[pre + "codec"])
        if (pre + "bitrate") in dev:
            try:
                a["bitrate"] = str(int(int(dev[pre + "bitrate"]) / 1000))
            except Exception:
                pass
    dev["params"] = p


def get_params(dev, kind):
    # (wifi_dict, usb_dict) merged with defaults.
    migrate_params(dev)
    p = (dev.get("params") or {}).get(kind) or {}
    out = []
    for t in ("wifi", "usb"):
        d = dict(PARAM_DEFAULTS[kind])
        d.update(p.get(t) or {})
        out.append(d)
    return out[0], out[1]


def active_params(dev, kind):
    wi, us = get_params(dev, kind)
    return us if use_usb(dev, kind) else wi


def media_params(dev, kind):
    # (buffer_ms, codec, bitrate_bps) for the transport in use.
    p = active_params(dev, kind)
    try:
        br = int(float(p.get("bitrate", 256)) * 1000)
    except Exception:
        br = 256000
    try:
        buf = int(float(p.get("buffer", 200)))
    except Exception:
        buf = 200
    return buf, p.get("codec", "flac"), br


def video_params(dev, mode):
    # (size, fps, bitrate_mbps, codec) for the transport in use.
    kind = "screen" if mode == "screen" else "camera"
    p = active_params(dev, kind)
    return str(p.get("size", "0")), str(p.get("fps", "0")), str(p.get("bitrate", "8")), p.get("codec", "h264")


def _pid_file(dev):
    return os.path.join(CONF_DIR, "stream_" + _sanitize_id(stream_target(dev)) + ".pid")


def _cache_file(dev):
    return os.path.join(CONF_DIR, "stream_" + _sanitize_id(stream_target(dev)) + ".addr")


def dev_connected(dev):
    return bool(stream_pids(dev, "audio"))


def _adb_ok(addr, timeout=3):
    if not addr:
        return False
    try:
        out = subprocess.run(["adb", "-s", addr, "get-state"],
                             capture_output=True, text=True, timeout=timeout)
        return out.stdout.strip() == "device"
    except Exception:
        return False


def dev_addr(dev):
    if dev.get("manual"):
        return dev.get("addr", "")
    ser = dev.get("serial") or ""
    if ser and ":" not in ser and _adb_ok(ser):  # USB-connected -> use the serial directly
        return ser
    cfg = dev.get("addr", "")
    try:
        c = open(_cache_file(dev)).read().strip()
    except Exception:
        c = ""
    # Prefer the scan-updated address if it is currently reachable via adb; else the cached one.
    for a in (cfg, c):
        if a and _adb_ok(a):
            return a
    return c or cfg


def set_pc_gain(dev, pct):
    # Attenuate this device's audio stream on the PC side. Needed for playback capture,
    # whose level ignores the phone volume. Uses pactl on the matching sink-input.
    node = "stream_" + _sanitize_id(stream_target(dev))
    try:
        out = subprocess.run(["pactl", "list", "sink-inputs"], capture_output=True,
                             text=True, timeout=6).stdout
    except Exception:
        return
    idx = cur = None
    for ln in out.splitlines():
        m = re.match(r"Sink Input #(\d+)", ln.strip())
        if m:
            cur = m.group(1)
            continue
        if cur and ('node.name = "%s"' % node) in ln:
            idx = cur
            break
    if idx:
        try:
            subprocess.run(["pactl", "set-sink-input-volume", idx, "%d%%" % max(0, min(100, int(pct)))],
                           capture_output=True, timeout=5)
        except Exception:
            pass


def start_stream(dev):
    if dev_connected(dev) or not os.path.exists(STREAM_SCRIPT):
        return
    try:
        buf, codec, br = media_params(dev, "audio")
        subprocess.Popen(["setsid", STREAM_SCRIPT, script_target(dev, "audio"),
                          node_base(dev) + " audio", str(buf), codec, str(br),
                          str(dev.get("source", "output"))],
                         start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except Exception:
        pass


def stop_stream(dev):
    # Pause playback first (best effort), then kill the stream process group.
    addr = dev_addr(dev)
    if addr:
        dump = run_adb(addr, ["dumpsys", "media_session"])
        info = parse_media(dump) if dump else None
        if info and info.get("state") == "PLAYING":
            run_adb(addr, ["input", "keyevent", "85"])
            time.sleep(0.6)
    for pid in stream_pids(dev, "audio"):
        _kill_tree(pid)
    try:
        os.remove(_pid_file(dev))
    except Exception:
        pass


def _mic_id(dev):
    return _sanitize_id(stream_target(dev)) + "_mic"


def _mic_pid_file(dev):
    return os.path.join(CONF_DIR, "stream_" + _mic_id(dev) + ".pid")


def mic_running(dev):
    return bool(stream_pids(dev, "mic"))


def start_mic(dev):
    if mic_running(dev) or not os.path.exists(STREAM_SCRIPT):
        return
    try:
        buf, codec, br = media_params(dev, "mic")
        subprocess.Popen(["setsid", STREAM_SCRIPT, script_target(dev, "mic"),
                          node_base(dev) + " mic",
                          str(buf), codec, str(br), "mic", "_mic"],
                         start_new_session=True, stdin=subprocess.DEVNULL,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except Exception:
        pass


def stop_mic(dev):
    for pid in stream_pids(dev, "mic"):
        _kill_tree(pid)
    try:
        os.remove(_mic_pid_file(dev))
    except Exception:
        pass


def _vid_id(dev, mode):
    return _sanitize_id(stream_target(dev)) + "_" + mode


def _vid_pid_file(dev, mode):
    return os.path.join(CONF_DIR, "stream_" + _vid_id(dev, mode) + ".pid")


def video_running(dev, mode):
    return bool(stream_pids(dev, "screen" if mode == "screen" else "camera"))


def start_video(dev, mode):
    if video_running(dev, mode) or not os.path.exists(VIDEO_SCRIPT):
        return
    try:
        kind = "screen" if mode == "screen" else "camera"
        for pid in stream_pids(dev, kind):   # clear any orphan for this role first
            _kill_tree(pid)
        size, fps, br, codec = video_params(dev, mode)
        subprocess.Popen(["setsid", VIDEO_SCRIPT, script_target(dev, kind),
                          mode, dev.get("name", ""), size, fps, br, codec],
                         start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL)
    except Exception:
        pass


def stop_video(dev, mode):
    role = "screen" if mode == "screen" else "camera"
    for pid in stream_pids(dev, role):
        _kill_tree(pid)
    try:
        os.remove(_vid_pid_file(dev, mode))
    except Exception:
        pass


def scan_mdns():
    # Discover wireless-debug devices via mDNS; keep only addresses that accept a TCP connection.
    try:
        out = subprocess.run(["avahi-browse", "-rtp", "_adb-tls-connect._tcp"],
                             capture_output=True, text=True, timeout=6).stdout
    except Exception:
        return []
    found = {}
    for line in out.splitlines():
        if not line.startswith("="):
            continue
        f = line.split(";")
        if len(f) < 10 or f[2] != "IPv4":
            continue
        svc, ip, port, txt = f[3], f[7], f[8], f[9]
        serial = ""
        m = re.search(r'"serial=([^"]+)"', txt)
        if m:
            serial = m.group(1)
        else:
            m = re.match(r"adb-(.+)-[^-]+$", svc)
            if m:
                serial = m.group(1)
        name = ""
        for key in ("given_name", "name"):
            m = re.search(r'"' + key + r'=([^"]+)"', txt)
            if m:
                name = m.group(1)
                break
        if not _tcp_ok(ip, port):
            continue
        addr = ip + ":" + port
        key = serial or addr
        found[key] = {"serial": serial, "name": name or serial or addr,
                      "addr": addr, "manual": False}
    return list(found.values())


def load_config():
    try:
        with open(CONFIG) as fh:
            data = json.load(fh)
            if isinstance(data, list):
                return data
    except Exception:
        pass
    return []


def save_config(devs):
    try:
        os.makedirs(CONF_DIR, exist_ok=True)
        with open(CONFIG, "w") as fh:
            json.dump(devs, fh, ensure_ascii=False, indent=2)
    except Exception:
        pass


def run_adb(dev, args, timeout=6):
    try:
        return subprocess.run(["adb", "-s", dev, "shell"] + args,
                              capture_output=True, text=True, timeout=timeout).stdout
    except Exception:
        return ""


def parse_media(dump):
    # Parse `dumpsys media_session` into the currently relevant session.
    m = re.search(r"Media button session is (\S+) \(userId=\d+\)", dump)
    active_tag = m.group(1) if m else None
    sessions, cur = [], None
    for line in dump.splitlines():
        h = re.match(r"^    (\S+)\s+(\S+)\s+\(userId=\d+\)\s*$", line)
        if h:
            if cur:
                sessions.append(cur)
            cur = {"tag": h.group(2)}
            continue
        if cur is None:
            continue
        s = line.strip()
        if s.startswith("package="):
            cur["package"] = s.split("=", 1)[1]
        elif s.startswith("state=PlaybackState"):
            mm = re.search(r"state=(\w+)\(", s)
            if mm:
                cur["state"] = mm.group(1)
        elif s.startswith("metadata:"):
            mm = re.search(r"description=(.*)$", s)
            if mm and mm.group(1) != "null":
                cur["description"] = mm.group(1)
    if cur:
        sessions.append(cur)
    # Drop KDE Connect mirrored sessions (that is the PC media, not the phone's own).
    sessions = [x for x in sessions if x.get("package") != "org.kde.kdeconnect_tp"]
    pick = None
    if active_tag:
        pick = next((x for x in sessions if x.get("tag") == active_tag), None)
    if not pick:
        for st in ("PLAYING", "PAUSED", "BUFFERING"):
            pick = next((x for x in sessions if x.get("state") == st), None)
            if pick:
                break
    if not pick:
        pick = next((x for x in sessions if x.get("description")), None)
    if not pick:
        return None
    desc = pick.get("description")
    title = artist = None
    if desc:
        parts = [p.strip() for p in desc.rsplit(",", 2)]
        if len(parts) >= 3 and parts[-1].lower() in ("null", ""):
            title = parts[0]
            artist = parts[1] if parts[1].lower() != "null" else None
        elif len(parts) >= 3:
            title, artist = parts[0], parts[1]
        else:
            title = desc
    return {"package": pick.get("package"), "state": pick.get("state"),
            "title": title, "artist": artist, "desc": desc}


MCP_SESSIONS = {}
MCP_TOKENS = {}
MCP_LOCK = threading.Lock()


def _mcp_close_all():
    # Close MCP sessions so they don't accumulate on the phone (server caps them -> 503).
    for url, sid in list(MCP_SESSIONS.items()):
        tok = MCP_TOKENS.get(url, "")
        try:
            subprocess.run(["curl", "-sk", "-m", "3", "-X", "DELETE", url,
                            "-H", "Authorization: Bearer " + tok,
                            "-H", "Mcp-Session-Id: " + sid],
                           capture_output=True, timeout=5)
        except Exception:
            pass
    MCP_SESSIONS.clear()
    MCP_TOKENS.clear()


def get_volume(addr):
    out = run_adb(addr, ["cmd", "media_session", "volume", "--stream", "3", "--get"])
    m = re.search(r"volume is (\d+) in range \[0\.\.(\d+)\]", out)
    if m:
        return int(m.group(1)), int(m.group(2))
    return None


def set_volume(addr, val):
    run_adb(addr, ["cmd", "media_session", "volume", "--stream", "3", "--set", str(int(val))])


LIKE_RE = re.compile(r"collect|favorite|like|\u6536\u85cf|\u559c\u6b22|\u7231\u5fc3|\u7ea2\u5fc3", re.I)


def mcp_like(dev):
    # Fire the media notification's like/collect action via the phone-side MCP.
    # True = fired, False = reachable but no like action, None = MCP unset/unreachable.
    url = dev.get("mcp_url")
    token = dev.get("mcp_token")
    if not url or not token:
        return None
    txt = _mcp_text(url, token, "android_notification_list", {})
    if not txt:
        return None
    i = txt.find('{"notifications"')
    if i < 0:
        return None
    try:
        data = json.loads(txt[i:])
    except Exception:
        return None
    for n in data.get("notifications", []) or []:
        for a in n.get("actions", []) or []:
            if LIKE_RE.search(a.get("title", "") or ""):
                _mcp_text(url, token, "android_notification_action",
                          {"notification_id": n.get("notification_id"),
                           "action_id": a.get("action_id")})
                return True
    return False


LIKE_UI_RE = re.compile(r"\u8d5e|\u559c\u6b22|\u6536\u85cf|like|favorite", re.I)


def mcp_tap_like(dev):
    # Tap an on-screen like/favorite button via MCP accessibility (for apps with no media
    # notification action, e.g. Xiaohongshu). Returns True if something was tapped.
    url = dev.get("mcp_url")
    token = dev.get("mcp_token")
    if not url or not token:
        return False
    txt = _mcp_text(url, token, "android_get_screen_state", {})
    if not txt:
        return False
    in_win = False
    for line in txt.splitlines():
        if line.startswith("--- window:"):
            in_win = ("type:APPLICATION" in line) and ("focused:true" in line)
            continue
        if line.startswith("--- ") or line.startswith("hierarchy:"):
            in_win = False
        if not in_win or line.startswith("node_id"):
            continue
        f = line.split("\t")
        if len(f) < 7:
            continue
        nid, text, desc, bounds, flags = f[0], f[2], f[3], f[5], f[6]
        label = (text if text and text != "-" else "") + " " + (desc if desc and desc != "-" else "")
        if not LIKE_UI_RE.search(label) or "clk" not in flags:
            continue
        if nid and not nid.startswith("node_"):
            nid = "node_" + nid
        r = _mcp_text(url, token, "android_click_node", {"node_id": nid})
        if r is not None and "rror" not in r:
            return True
        m = re.match(r"(\d+),(\d+),(\d+),(\d+)", bounds or "")
        if m:
            x1, y1, x2, y2 = map(int, m.groups())
            _mcp_text(url, token, "android_tap", {"x": (x1 + x2) // 2, "y": (y1 + y2) // 2})
            return True
    return False


def send_favorite(dev):
    # MCP first: notification like action, then an on-screen like tap.
    # The adb notification-shade fallback is only used when MCP is not available.
    try:
        r = mcp_like(dev)
    except Exception:
        r = None
    if r is True:
        return True
    if r is False:
        try:
            return mcp_tap_like(dev)
        except Exception:
            return False
    addr = dev_addr(dev)
    if not addr:
        return False
    try:
        run_adb(addr, ["cmd", "statusbar", "expand-notifications"], timeout=5)
        time.sleep(1.2)
        run_adb(addr, ["uiautomator", "dump", "/sdcard/.ps_ui.xml"], timeout=8)
        xml = run_adb(addr, ["cat", "/sdcard/.ps_ui.xml"], timeout=6)
        cx = cy = None
        for m in re.finditer(r"<node[^>]*>", xml):
            tag = m.group(0)
            if 'clickable="true"' not in tag:
                continue
            cd = re.search(r'content-desc="([^"]*)"', tag)
            tx = re.search(r'text="([^"]*)"', tag)
            label = (cd.group(1) if cd else "") + " " + (tx.group(1) if tx else "")
            if not LIKE_RE.search(label):
                continue
            b = re.search(r'bounds="\[(\d+),(\d+)\]\[(\d+),(\d+)\]"', tag)
            if b:
                x1, y1, x2, y2 = map(int, b.groups())
                cx, cy = (x1 + x2) // 2, (y1 + y2) // 2
                break
        if cx is not None:
            run_adb(addr, ["input", "tap", str(cx), str(cy)], timeout=5)
        run_adb(addr, ["cmd", "statusbar", "collapse"], timeout=5)
        run_adb(addr, ["rm", "-f", "/sdcard/.ps_ui.xml"], timeout=5)
        return cx is not None
    except Exception:
        return False


def _mcp_curl(url, token, body, sid=None, dump_headers=False, timeout=8):
    args = ["curl", "-sk", "-m", str(timeout), "-X", "POST", url,
            "-H", "Authorization: Bearer " + token,
            "-H", "Content-Type: application/json",
            "-H", "Accept: application/json, text/event-stream"]
    if dump_headers:
        args += ["-D", "-"]
    if sid:
        args += ["-H", "Mcp-Session-Id: " + sid]
    args += ["-d", json.dumps(body)]
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=timeout + 3).stdout
    except Exception:
        return ""


def _mcp_session(url, token):
    sid = MCP_SESSIONS.get(url)
    if sid:
        return sid
    with MCP_LOCK:
        sid = MCP_SESSIONS.get(url)
        if sid:
            return sid
        out = _mcp_curl(url, token, {"jsonrpc": "2.0", "id": 1, "method": "initialize",
            "params": {"protocolVersion": "2024-11-05", "capabilities": {},
                       "clientInfo": {"name": "phone-stream", "version": "1"}}}, dump_headers=True)
        sid = None
        for ln in out.splitlines():
            if ln.lower().startswith("mcp-session-id:"):
                sid = ln.split(":", 1)[1].strip()
        if sid:
            _mcp_curl(url, token, {"jsonrpc": "2.0", "method": "notifications/initialized"}, sid)
            MCP_SESSIONS[url] = sid
            MCP_TOKENS[url] = token
        return sid


def _mcp_text(url, token, name, args):
    sid = _mcp_session(url, token)
    if not sid:
        return None
    out = _mcp_curl(url, token, {"jsonrpc": "2.0", "id": 2, "method": "tools/call",
                                 "params": {"name": name, "arguments": args}}, sid)
    if not out:
        return None
    i = out.find('{"jsonrpc"')
    if i > 0:
        out = out[i:]
    try:
        d = json.loads(out)
    except Exception:
        return None
    for c in d.get("result", {}).get("content", []):
        if c.get("type") == "text":
            return c.get("text", "")
    return ""


def mcp_media(dev):
    # MCP fallback: read the foreground app's title from the phone screen via accessibility.
    # Returns (info_or_None, status); status: None = MCP not configured, "down" = unreachable, "ok" = reachable.
    url = dev.get("mcp_url")
    token = dev.get("mcp_token")
    if not url or not token:
        return None, None
    txt = _mcp_text(url, token, "android_get_screen_state", {})
    if txt is None or "Error executing" in txt:
        return None, "down"
    pkg = None
    title = artist = None
    in_win = False
    candidates = []
    for line in txt.splitlines():
        if line.startswith("--- window:"):
            in_win = ("type:APPLICATION" in line) and ("focused:true" in line)
            if in_win:
                m = re.search(r"pkg:(\S+)", line)
                pkg = m.group(1) if m else None
            continue
        if line.startswith("--- ") or line.startswith("hierarchy:"):
            in_win = False
        if not in_win or line.startswith("node_id"):
            continue
        f = line.split("\t")
        if len(f) < 5:
            continue
        text, resid = f[2], f[4]
        val = text if text and text != "-" else ""
        if resid.endswith("noteContentText") and val:
            title = val
        elif "NickName" in resid and val and not artist:
            artist = val
        if val and len(val) >= 4 and "说点什么" not in val and not val.replace(".", "").isdigit():
            candidates.append(val)
    if not title and candidates:
        title = max(candidates, key=len)
    if not title:
        return None, "ok"
    return {"package": pkg, "state": "PLAYING", "title": title, "artist": artist}, "ok"


def dev_key(d):
    return d.get("serial") or d.get("addr")


def node_base(dev):
    # Short tag for the PipeWire node name, e.g. "REDMI K80" -> "k80".
    s = (dev.get("short") or dev.get("name") or "").strip()
    s = re.sub(r"^(redmi|xiaomi|mi)\s+", "", s, flags=re.I).strip()
    return s.lower() or "phone"


def stream_pids(dev, role):
    # Live pids of this device's stream for the given role (audio/mic/screen/camera),
    # detected from the process list so it works even if a pid file went missing.
    tgt = stream_target(dev)
    base = node_base(dev)
    res = []
    for pid, args in _running_procs():
        if tgt and tgt not in args:
            continue
        if role == "audio" and (base + " audio") in args:
            res.append(pid)
        elif role == "mic" and (base + " mic") in args:
            res.append(pid)
        elif role == "screen" and "phone_video_scrcpy" in args and " screen " in args:
            res.append(pid)
        elif role == "camera" and "phone_video_scrcpy" in args and (" camera " in args or " camera-back " in args):
            res.append(pid)
    return res


class App:
    def __init__(self, root):
        self.root = root
        self.devices = load_config()
        self.cards = {}
        self._polling = {}
        root.title(t("app_title"))
        root.geometry("660x720")
        root.minsize(430, 280)
        root.configure(bg=BG)
        root.protocol("WM_DELETE_WINDOW", self.on_close)
        apply_style(root)
        self._build()
        self._sync_cards()
        self.root.after(200, self.refresh)
        self.root.after(400, self.force_scan)
        self.root.after(SCAN_MS, self._auto_scan)

    def on_close(self):
        # On close, tear down every connection (audio / mic / camera / screen).
        def clean():
            for d in list(self.devices):
                try:
                    if dev_connected(d):
                        stop_stream(d)
                    if mic_running(d):
                        stop_mic(d)
                    if video_running(d, "camera"):
                        stop_video(d, "camera")
                    if video_running(d, "screen"):
                        stop_video(d, "screen")
                except Exception:
                    pass
        th = threading.Thread(target=clean, daemon=True)
        th.start()
        th.join(timeout=6)
        _mcp_close_all()
        self.root.destroy()

    def toggle_lang(self):
        # Switch UI language, persist it, and rebuild the whole window.
        global LANG
        LANG = "en" if LANG == "zh" else "zh"
        save_lang(LANG)
        self._relang()

    def _relang(self):
        for w in self.root.winfo_children():
            w.destroy()
        self.cards = {}
        self.placeholder = None
        self.root.title(t("app_title"))
        self._build()
        self._sync_cards()
        self.root.after(30, self.refresh)

    def _build(self):
        top = tk.Frame(self.root, bg=BG)
        top.pack(fill=tk.X, padx=14, pady=(12, 6))
        tk.Label(top, text=t("app_title"), bg=BG, fg="#89b4fa",
                 font=(DEF_FONT, 14, "bold")).pack(side=tk.LEFT)
        tk.Button(top, text=t("add"), command=self.add_manual).pack(side=tk.RIGHT)
        tk.Button(top, text=t("scan"), command=self.force_scan).pack(side=tk.RIGHT, padx=4)
        tk.Button(top, text=("EN" if LANG == "zh" else "中文"),
                  command=self.toggle_lang).pack(side=tk.RIGHT, padx=4)
        self.card_box = tk.Frame(self.root, bg=BG)
        self.card_box.pack(fill=tk.BOTH, expand=True, padx=10, pady=4)
        self.placeholder = None

    def _make_card(self, d):
        bg = CARD
        card = tk.Frame(self.card_box, bg=bg, highlightbackground="#45475a",
                        highlightthickness=1)
        card.pack(fill=tk.X, pady=6, padx=2)

        head = tk.Frame(card, bg=bg)
        head.pack(fill=tk.X, padx=12, pady=(9, 2))
        # Pack the button group first so it keeps priority and is never clipped when the window shrinks.
        btnbox = tk.Frame(head, bg=bg)
        btnbox.pack(side=tk.RIGHT)

        def chip(label, cmd, width=4):
            return tk.Button(btnbox, text=label, width=width, relief="flat", bd=0,
                             font=(DEF_FONT, 9, "bold"), cursor="hand2",
                             command=cmd, **chip_style(False, CHIP_OFF))

        togb = tk.Button(btnbox, text=t("connect"), width=6, relief="flat", bd=0,
                         font=(DEF_FONT, 10), cursor="hand2",
                         command=lambda dd=d: self.do_toggle_conn(dd),
                         **chip_style(False, CHIP_OFF))
        micb = chip("MIC", lambda dd=d: self.do_mic(dd))
        camb = chip("CAM", lambda dd=d: self.do_camera(dd))
        scrb = chip("SCR", lambda dd=d: self.do_screen(dd))
        setb = chip("SET", lambda dd=d: self.open_settings(dd))
        for b in (togb, micb, camb, scrb, setb):
            b.pack(side=tk.LEFT, padx=3, pady=1)
        # Device info on the left (yields space to the buttons when narrow).
        dot = tk.Label(head, text="○", bg=bg, fg="#f38ba8", font=(DEF_FONT, 11))
        dot.pack(side=tk.LEFT)
        tag = t("manual") if d.get("manual") else ""
        name = tk.Label(head, text=(d.get("name", "?") + tag), bg=bg, fg="#89b4fa",
                        font=(DEF_FONT, 12, "bold"))
        name.pack(side=tk.LEFT, padx=(4, 8))
        addr = tk.Label(head, text=d.get("addr", ""), bg=bg, fg="#6c7086",
                        font=(DEF_FONT, 9))
        addr.pack(side=tk.LEFT)

        player = tk.Label(card, text=t("no_media"), bg=bg, fg="#89b4fa",
                          font=(DEF_FONT, 13, "bold"), anchor="w")
        player.pack(fill=tk.X, padx=14, pady=(4, 0))
        title = tk.Label(card, text="", bg=bg, fg=FG, font=(DEF_FONT, 11),
                         anchor="w", justify="left", wraplength=520)
        title.pack(fill=tk.X, padx=14)
        artist = tk.Label(card, text="", bg=bg, fg=SUB, font=(DEF_FONT, 9), anchor="w")
        artist.pack(fill=tk.X, padx=14)

        bar = tk.Frame(card, bg=bg)
        bar.pack(fill=tk.X, padx=12, pady=(5, 8))
        tk.Button(bar, text="⏮", width=3,
                  command=lambda dd=d: self.send_key(dd, 88)).pack(side=tk.LEFT, padx=1)
        pp = tk.Button(bar, text="▶", width=3,
                       command=lambda dd=d: self.send_key(dd, 85))
        pp.pack(side=tk.LEFT, padx=1)
        tk.Button(bar, text="⏭", width=3,
                  command=lambda dd=d: self.send_key(dd, 87)).pack(side=tk.LEFT, padx=1)
        tk.Button(bar, text="♥", width=3, fg="#f38ba8",
                  command=lambda dd=d: threading.Thread(
                      target=send_favorite, args=(dd,), daemon=True).start()
                  ).pack(side=tk.LEFT, padx=(1, 8))
        tk.Button(bar, text="🔉", width=3,
                  command=lambda dd=d: self.send_key(dd, 25)).pack(side=tk.LEFT, padx=1)
        tk.Button(bar, text="🔊", width=3,
                  command=lambda dd=d: self.send_key(dd, 24)).pack(side=tk.LEFT, padx=(1, 8))
        vol_var = tk.DoubleVar(value=0)
        vol_scale = ttk.Scale(bar, from_=0, to=150, orient="horizontal", variable=vol_var, length=150)
        vol_val = tk.Label(bar, text="", bg=bg, fg=SUB, font=(DEF_FONT, 9), width=4)
        vol_scale.pack(side=tk.LEFT, padx=4)
        vol_val.pack(side=tk.LEFT)
        vol_scale.configure(command=lambda v, lv=vol_val: lv.config(text=str(int(float(v)))))
        state = tk.Label(bar, text="", bg=bg, fg="#6c7086", font=(DEF_FONT, 9))
        state.pack(side=tk.RIGHT, padx=4)
        vol_state = {"dragging": False}

        def _vol_press(e, s=vol_state):
            s["dragging"] = True

        def _vol_release(e, dd=d, vv=vol_var, s=vol_state):
            # No absolute-set on some phones; drive relative volume keys by the slider delta.
            s["dragging"] = False
            target = int(float(vv.get()))
            last = int(s.get("last", target))
            s["last"] = target
            delta = target - last
            a = dev_addr(dd)
            if a and delta:
                steps = int(round(delta / 10.0)) or (1 if delta > 0 else -1)
                code = "24" if steps > 0 else "25"

                def worker():
                    for _ in range(abs(steps)):
                        run_adb(a, ["input", "keyevent", code], timeout=5)
                threading.Thread(target=worker, daemon=True).start()

        vol_scale.bind("<ButtonPress-1>", _vol_press)
        vol_scale.bind("<ButtonRelease-1>", _vol_release)

        if (d.get("source") or "output") == "playback":
            # PC-side gain: playback capture ignores the phone volume, so attenuate here.
            gbar = tk.Frame(card, bg=bg)
            gbar.pack(fill=tk.X, padx=12, pady=(0, 8))
            tk.Label(gbar, text=t("pc_gain"), bg=bg, fg=SUB,
                     font=(DEF_FONT, 9)).pack(side=tk.LEFT)
            gvar = tk.DoubleVar(value=100)
            gsc = ttk.Scale(gbar, from_=0, to=100, orient="horizontal", variable=gvar, length=180)
            gval = tk.Label(gbar, text="100%", bg=bg, fg=SUB, font=(DEF_FONT, 9), width=5)
            gsc.pack(side=tk.LEFT, padx=4)
            gval.pack(side=tk.LEFT)
            gsc.configure(command=lambda v, lv=gval: lv.config(text="%d%%" % int(float(v))))
            gsc.bind("<ButtonRelease-1>", lambda e, dd=d, vv=gvar: threading.Thread(
                target=set_pc_gain, args=(dd, int(float(vv.get()))), daemon=True).start())

        return {"frame": card, "dot": dot, "name": name, "addr": addr,
                "tog": togb, "micb": micb, "camb": camb, "scrb": scrb,
                "player": player, "title": title, "artist": artist, "pp": pp,
                "state": state, "vol_scale": vol_scale, "vol_var": vol_var,
                "vol_val": vol_val, "vol_state": vol_state, "dev": d}

    def _sync_cards(self):
        keys = [dev_key(d) for d in self.devices]
        for k in list(self.cards):
            if k not in keys:
                self.cards[k]["frame"].destroy()
                del self.cards[k]
        for d in self.devices:
            k = dev_key(d)
            if k not in self.cards:
                self.cards[k] = self._make_card(d)
        if not self.devices:
            if self.placeholder is None:
                self.placeholder = tk.Label(
                    self.card_box, text=t("placeholder"),
                    bg=BG, fg="#6c7086", font=(DEF_FONT, 11))
                self.placeholder.pack(anchor="w", pady=8)
        elif self.placeholder is not None:
            self.placeholder.destroy()
            self.placeholder = None
        self._update_conn_states()

    def _update_conn_states(self):
        for k, c in self.cards.items():
            d = c["dev"]
            st = c.setdefault("st", {})
            connected = bool(dev_connected(d))
            mic = bool(mic_running(d))
            cam = bool(video_running(d, "camera"))
            scr = bool(video_running(d, "screen"))
            if st.get("conn") != connected:
                st["conn"] = connected
                c["tog"].config(text=t("disconnect") if connected else t("connect"),
                                **chip_style(connected, ACC_MIC))
                c["dot"].config(text="\u25cf" if connected else "\u25cb",
                                fg="#a6e3a1" if connected else "#f38ba8")
            if st.get("mic") != mic:
                st["mic"] = mic
                c["micb"].config(**chip_style(mic, ACC_MIC))
            if st.get("cam") != cam:
                st["cam"] = cam
                c["camb"].config(**chip_style(cam, ACC_CAM))
            if st.get("scr") != scr:
                st["scr"] = scr
                c["scrb"].config(**chip_style(scr, ACC_SCR))
            usb = usb_ok(d)
            if st.get("iface") != (usb, d.get("addr", "")):
                st["iface"] = (usb, d.get("addr", ""))
                c["addr"].config(text=d.get("addr", "") + ("  \u00b7 USB" if usb else ""))

    def force_scan(self):
        threading.Thread(target=self._scan_and_merge, daemon=True).start()

    def _auto_scan(self):
        threading.Thread(target=self._scan_and_merge, daemon=True).start()
        self.root.after(SCAN_MS, self._auto_scan)

    def _scan_and_merge(self):
        found = scan_mdns()
        if found:
            by_key = {dev_key(d): d for d in self.devices}
            changed = False
            for f in found:
                key = dev_key(f)
                if key in by_key:
                    cur = by_key[key]
                    if cur.get("addr") != f["addr"]:
                        cur["addr"] = f["addr"]
                        changed = True
                    if not cur.get("name") and f.get("name"):
                        cur["name"] = f["name"]
                        changed = True
                else:
                    self.devices.append(f)
                    changed = True
            if changed:
                save_config(self.devices)
        self.root.after(0, self._sync_cards)

    def open_settings(self, dev):
        win = tk.Toplevel(self.root)
        win.title(t("settings_title").format(name=dev.get("name", "")))
        win.configure(bg=BG)
        win.geometry("660x470")
        win.transient(self.root)
        win.grab_set()
        win.update_idletasks()
        try:
            x = self.root.winfo_rootx() + (self.root.winfo_width() - win.winfo_width()) // 2
            y = self.root.winfo_rooty() + 60
            win.geometry("+%d+%d" % (max(0, x), max(0, y)))
        except Exception:
            pass

        name_var = tk.StringVar(value=dev.get("name", ""))
        source_var = tk.StringVar(value=dev.get("source", "output"))
        vars = {}  # vars[kind][transport][key] = StringVar

        nb = ttk.Notebook(win)
        nb.pack(fill=tk.BOTH, expand=True, padx=8, pady=(8, 2))

        # General tab
        gen = tk.Frame(nb, bg=BG)
        nb.add(gen, text=t("tab_general"))
        tk.Label(gen, text=t("name"), bg=BG, fg=FG, font=(DEF_FONT, 10)).grid(
            row=0, column=0, sticky="w", padx=14, pady=10)
        tk.Entry(gen, textvariable=name_var, width=26).grid(row=0, column=1, sticky="w")

        def label_for(kind, key):
            if key == "codec":
                return t("vcodec") if kind in ("screen", "camera") else t("codec")
            if key == "bitrate":
                return t("bitrate_mbps") if kind in ("screen", "camera") else t("bitrate_kbps")
            return {"buffer": t("delay"), "size": t("size"), "fps": t("fps")}.get(key, key)

        def make_widget(box, kind, key, var):
            if key == "buffer":
                return ttk.Combobox(box, values=["50", "100", "150", "200", "300", "500", "800"],
                                    textvariable=var, width=9)
            if key == "fps":
                return ttk.Combobox(box, values=["0", "15", "24", "25", "30", "48", "50", "60", "90", "120"],
                                    textvariable=var, width=9)
            if key == "size":
                if kind == "screen":
                    vals = ["0", "2400", "2160", "1920", "1600", "1440", "1280", "1080", "900", "720", "600", "480"]
                else:
                    vals = ["320x240", "640x480", "800x600", "1024x768", "1280x720",
                            "1600x1200", "1920x1080", "2560x1440", "3840x2160"]
                return ttk.Combobox(box, values=vals, textvariable=var, width=13)
            if key == "codec":
                vals = (["flac", "opus", "aac"] if kind in ("audio", "mic")
                        else ["h264", "h265", "av1", "vp8", "vp9"])
                return ttk.Combobox(box, values=vals, textvariable=var, state="readonly", width=8)
            if key == "bitrate":
                vals = (["64", "96", "128", "160", "192", "256", "320", "510"] if kind in ("audio", "mic")
                        else ["1", "2", "4", "6", "8", "10", "12", "16", "20", "30", "50"])
                return ttk.Combobox(box, values=vals, textvariable=var, width=8)
            return tk.Entry(box, textvariable=var, width=11)

        def ptab(kind):
            fr = tk.Frame(nb, bg=BG)
            nb.add(fr, text=t("tab_" + kind))
            vars[kind] = {}
            base = 0
            if kind == "audio":
                srow = tk.Frame(fr, bg=BG)
                srow.grid(row=0, column=0, columnspan=2, sticky="w", padx=18, pady=(16, 2))
                tk.Label(srow, text=t("source"), bg=BG, fg=FG,
                         font=(DEF_FONT, 10)).pack(side=tk.LEFT)
                ttk.Combobox(srow, values=["output", "playback", "mic"],
                             textvariable=source_var, state="readonly",
                             width=16).pack(side=tk.LEFT, padx=10)
                tk.Label(srow, text=t("source_hint"), bg=BG, fg="#6c7086",
                         font=(DEF_FONT, 8)).pack(side=tk.LEFT)
                base = 1
            wi, us = get_params(dev, kind)
            for col, (tr_name, src) in enumerate((("WiFi", wi), ("USB", us))):
                lf = ttk.LabelFrame(fr, text=" " + tr_name + " ")
                lf.grid(row=base, column=col, sticky="n", padx=18, pady=14)
                for i, key in enumerate(PARAM_KEYS[kind]):
                    tk.Label(lf, text=label_for(kind, key), bg=BG, fg=SUB,
                             font=(DEF_FONT, 9)).grid(row=i, column=0, sticky="e",
                                                      padx=(14, 10), pady=6)
                    v = tk.StringVar(value=str(src.get(key, "")))
                    make_widget(lf, kind, key, v).grid(row=i, column=1, sticky="w",
                                                       padx=(0, 16), pady=6)
                    vars[kind].setdefault(tr_name.lower(), {})[key] = v
            if kind in ("screen", "camera"):
                tk.Label(fr, text=t("size_hint"), bg=BG, fg="#6c7086",
                         font=(DEF_FONT, 8)).grid(row=base + 1, column=0, columnspan=2,
                                                  sticky="w", padx=18, pady=(0, 8))
            return fr

        def ctab():
            fr = tk.Frame(nb, bg=BG)
            nb.add(fr, text=t("connection"))
            tk.Label(fr, text=t("conn_hint"), bg=BG, fg="#6c7086",
                     font=(DEF_FONT, 8)).grid(row=0, column=0, columnspan=2, sticky="w",
                                              padx=18, pady=(16, 8))
            cv = {}
            for i, kind in enumerate(CONN_KINDS):
                tk.Label(fr, text=t("conn_" + kind), bg=BG, fg=FG,
                         font=(DEF_FONT, 10)).grid(row=1 + i, column=0, sticky="e",
                                                   padx=(18, 12), pady=8)
                v = tk.StringVar(value=conn_choice(dev, kind))
                cv[kind] = v
                ttk.Combobox(fr, values=["auto", "wifi", "usb"], textvariable=v,
                             state="readonly", width=14).grid(row=1 + i, column=1, sticky="w")
            return cv

        ptab("audio")
        ptab("mic")
        ptab("screen")
        ptab("camera")
        conn_vars = ctab()

        def save():
            nm = name_var.get().strip()
            if nm:
                dev["name"] = nm
            dev["source"] = source_var.get()
            p = dev.get("params")
            if not isinstance(p, dict):
                p = {}
                dev["params"] = p
            for kind in PARAM_KEYS:
                pk = p.get(kind)
                if not isinstance(pk, dict):
                    pk = {}
                    p[kind] = pk
                for tr in ("wifi", "usb"):
                    td = pk.get(tr)
                    if not isinstance(td, dict):
                        td = {}
                        pk[tr] = td
                    for key in PARAM_KEYS[kind]:
                        td[key] = vars[kind][tr][key].get().strip()
            dev["conn"] = {k: v.get() for k, v in conn_vars.items()}
            save_config(self.devices)
            self._sync_cards()
            win.destroy()

        btns = tk.Frame(win, bg=BG)
        btns.pack(pady=10)
        tk.Button(btns, text=t("save"), width=10, command=save).pack(side=tk.LEFT, padx=6)
        tk.Button(btns, text=t("cancel"), width=10, command=win.destroy).pack(side=tk.LEFT, padx=6)

    def add_manual(self):
        addr = simpledialog.askstring(t("add_title"), t("add_addr"), parent=self.root)
        if not addr:
            return
        addr = addr.strip()
        name = simpledialog.askstring(t("add_title"), t("add_name"), parent=self.root)
        name = (name or addr).strip()
        for d in self.devices:
            if d.get("manual") and d.get("addr") == addr:
                d["name"] = name
                save_config(self.devices)
                self._sync_cards()
                return
        self.devices.append({"serial": addr, "name": name, "addr": addr, "manual": True,
                             "buffer": 200, "codec": "flac", "bitrate": 256000})
        save_config(self.devices)
        self._sync_cards()

    def do_connect(self, dev):
        threading.Thread(target=start_stream, args=(dev,), daemon=True).start()
        self.root.after(2000, self._sync_cards)
        self.root.after(2500, self.refresh)

    def do_disconnect(self, dev):
        threading.Thread(target=stop_stream, args=(dev,), daemon=True).start()
        self.root.after(1800, self._sync_cards)
        self.root.after(1800, self.refresh)

    def do_toggle_conn(self, dev):
        if dev_connected(dev):
            self.do_disconnect(dev)
        else:
            self.do_connect(dev)

    def do_mic(self, dev):
        # Toggle the mic stream for this device (independent from the audio stream).
        if mic_running(dev):
            threading.Thread(target=stop_mic, args=(dev,), daemon=True).start()
        else:
            threading.Thread(target=start_mic, args=(dev,), daemon=True).start()
        self.root.after(1600, self._sync_cards)
        self.root.after(2000, self.refresh)

    def do_camera(self, dev):
        self._toggle_video(dev, "camera")

    def do_screen(self, dev):
        self._toggle_video(dev, "screen")

    def _toggle_video(self, dev, mode):
        if video_running(dev, mode):
            threading.Thread(target=stop_video, args=(dev, mode), daemon=True).start()
        else:
            threading.Thread(target=start_video, args=(dev, mode), daemon=True).start()
        self.root.after(1600, self._sync_cards)

    def send_key(self, dev, code):
        addr = dev_addr(dev)
        if not addr:
            return
        threading.Thread(target=lambda: run_adb(addr, ["input", "keyevent", str(code)]),
                         daemon=True).start()
        self.root.after(400, self.refresh)

    def refresh(self):
        for d in list(self.devices):
            k = dev_key(d)
            if self._polling.get(k):
                continue  # skip if the previous poll is still running (avoids UI flicker)
            self._polling[k] = True
            threading.Thread(target=self._poll_one, args=(d,), daemon=True).start()
        self.root.after(POLL_MS, self.refresh)

    def _poll_one(self, d):
        try:
            connected = dev_connected(d)
            addr = dev_addr(d)
            info = None
            vol = None
            if addr:
                dump = run_adb(addr, ["dumpsys", "media_session"])
                info = parse_media(dump) if dump else None
                vol = get_volume(addr)
            mcp_status = None
            if not info:
                try:
                    info, mcp_status = mcp_media(d)
                except Exception:
                    info, mcp_status = None, None
            self.root.after(0, lambda: self._update_card(d, connected, info, mcp_status, vol))
        finally:
            self._polling[dev_key(d)] = False

    def _update_card(self, d, connected, info, mcp_status=None, vol=None):
        c = self.cards.get(dev_key(d))
        if not c:
            return
        tag = t("manual") if d.get("manual") else ""
        c["name"].config(text=d.get("name", "?") + tag)
        vs = c.get("vol_state")
        if vol and vs and not vs.get("dragging") and vs.get("last") != vol[0]:
            vs["last"] = vol[0]
            try:
                c["vol_scale"].configure(to=vol[1])
                c["vol_var"].set(vol[0])
                c["vol_val"].config(text=str(vol[0]))
            except Exception:
                pass
        if not info or not info.get("package"):
            c["player"].config(text=t("no_media"))
            c["title"].config(text="")
            c["artist"].config(text="")
            if mcp_status == "down":
                c["state"].config(text=t("mcp_down"), fg="#f38ba8")
            else:
                c["state"].config(text="", fg="#6c7086")
            c["pp"].config(text=t("play"))
            return
        pkg = info.get("package")
        c["player"].config(text=PKG_NAMES.get(pkg, pkg))
        c["title"].config(text=info.get("title") or t("no_title"))
        c["artist"].config(text=info.get("artist") or "")
        st = info.get("state") or "NONE"
        c["state"].config(text=STATE_NAMES[LANG].get(st, st), fg="#6c7086")
        c["pp"].config(text=t("pause") if st == "PLAYING" else t("play"))


def main():
    os.makedirs(CONF_DIR, exist_ok=True)
    lf = open(LOCK, "w")
    try:
        fcntl.flock(lf, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        return

    def _bye(*_a):
        # Close MCP sessions on SIGTERM/INT so they don't pile up on the phone.
        _mcp_close_all()
        os._exit(0)

    signal.signal(signal.SIGTERM, _bye)
    signal.signal(signal.SIGINT, _bye)
    root = tk.Tk()
    App(root)
    root.mainloop()


if __name__ == "__main__":
    main()
